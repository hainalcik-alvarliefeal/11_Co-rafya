<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coğrafyanın Doğası - Etkinlik Formu</title>
    <style>
        :root {
            --bg-color: #f4f6f4;
            --card-bg: #ffffff;
            --primary-green: #2d5a27;
            --light-green: #e8f0e6;
            --earth-brown: #8c6d46;
            --text-color: #2b332a;
            --border-color: #c2d0be;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 800px;
            background: var(--card-bg);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(45, 90, 39, 0.08);
            border-top: 6px solid var(--primary-green);
        }

        h2 {
            color: var(--primary-green);
            margin-bottom: 5px;
            font-size: 24px;
        }

        .subtitle {
            color: var(--earth-brown);
            font-size: 14px;
            margin-bottom: 30px;
            font-weight: 600;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--primary-green);
        }

        input[type="text"], textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 14px;
            background-color: #fafbfc;
            box-sizing: border-box;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus, textarea:focus {
            outline: none;
            border-color: var(--primary-green);
            background-color: #fff;
        }

        textarea {
            resize: vertical;
            height: 90px;
        }

        fieldset {
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
            background-color: var(--light-green);
        }

        legend {
            font-weight: bold;
            color: var(--primary-green);
            background: var(--card-bg);
            padding: 5px 12px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
        }

        button {
            background-color: var(--primary-green);
            color: white;
            border: none;
            padding: 14px 24px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: #23461e;
        }

        #status {
            margin-top: 15px;
            text-align: center;
            font-weight: 600;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Coğrafyanın Doğası: Mekânsal Sorunlar</h2>
    <div class="subtitle">Etkinlik Değerlendirme ve Raporlama Formu</div>

    <form id="etkinlikForm">
        <div class="form-group">
            <label for="adSoyad">Ad Soyad:</label>
            <input type="text" id="adSoyad" required placeholder="Adınızı ve soyadınızı giriniz">
        </div>

        <fieldset>
            <legend>1. Makale: Kuraklık</legend>
            <div class="form-group">
                <label for="makale1_sorun">Mekânsal Sorunlar:</label>
                <textarea id="makale1_sorun" placeholder="Kuraklığın kırsal ve kentleşme üzerindeki olumsuz etkileri..."></textarea>
            </div>
            <div class="form-group">
                <label for="makale1_katki">Coğrafya Biliminin Katkısı:</label>
                <textarea id="makale1_katki" placeholder="Uzaktan algılama, erken uyarı sistemleri vb..."></textarea>
            </div>
        </fieldset>

        <fieldset>
            <legend>2. Makale: Sünger Şehirler</legend>
            <div class="form-group">
                <label for="makale2_sorun">Mekânsal Sorunlar:</label>
                <textarea id="makale2_sorun" placeholder="Gri altyapı, sel felaketleri ve su kıtlığı..."></textarea>
            </div>
            <div class="form-group">
                <label for="makale2_katki">Coğrafya Biliminin Katkısı:</label>
                <textarea id="makale2_katki" placeholder="Yeşil altyapı, suyun kaynağında yönetilmesi vb..."></textarea>
            </div>
        </fieldset>

        <div class="form-group">
            <label for="cevre_hata">4. Adım - Yakın Çevrenizdeki Hatalı Uygulamalar:</label>
            <textarea id="cevre_hata" placeholder="Mekânsal sorunlar bağlamında yakın çevrenizde yapılan hatalar..."></textarea>
        </div>

        <div class="form-group">
            <label for="cozum_onerisi">5. Adım - Alternatif Çözüm Önerileriniz:</label>
            <textarea id="cozum_onerisi" placeholder="Bilimsel çalışmalar ışığında alternatif çözüm önerileriniz..."></textarea>
        </div>

        <div class="form-group">
            <label for="en_onemli">Değerlendirme (En Önemli Katkı):</label>
            <textarea id="en_onemli" placeholder="Coğrafya biliminin katkıları arasında öğrendiğiniz en önemli husus..."></textarea>
        </div>

        <button type="submit">Etkinliği Gönder</button>
        <div id="status"></div>
    </form>
</div>

<script>
    // Google Apps Script Dağıtım URL'nizi buraya yapıştırın:
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxUjBzmHKKzdUHg5bY-mgmzZUnarF11BfpL20_cj3tTsVZLqxwMNlaR7Tx06Ydi0jMWmw/exec";

    const form = document.getElementById('etkinlikForm');
    const statusDiv = document.getElementById('status');

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        statusDiv.style.color = "#8c6d46";
        statusDiv.innerText = "Gönderiliyor...";

        const data = {
            adSoyad: document.getElementById('adSoyad').value,
            makale1_sorun: document.getElementById('makale1_sorun').value,
            makale1_katki: document.getElementById('makale1_katki').value,
            makale2_sorun: document.getElementById('makale2_sorun').value,
            makale2_katki: document.getElementById('makale2_katki').value,
            cevre_hata: document.getElementById('cevre_hata').value,
            cozum_onerisi: document.getElementById('cozum_onerisi').value,
            en_onemli: document.getElementById('en_onemli').value
        };

        fetch(SCRIPT_URL, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        })
        .then(() => {
            statusDiv.style.color = "#2d5a27";
            statusDiv.innerText = "Etkinliğiniz başarıyla kaydedildi! Teşekkürler.";
            form.reset();
        })
        .catch((err) => {
            statusDiv.style.color = "red";
            statusDiv.innerText = "Bir hata oluştu, lütfen tekrar deneyin.";
        });
    });
</script>

</body>
</html>
